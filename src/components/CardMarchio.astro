---
// CardMarchio.astro — compatta (nome + prodotti), solo logo (Home) o estesa
// (logo, descrizione, reparti). Il marchio in sé non è un link: portava al
// suo primo reparto, una destinazione arbitraria. Si naviga dai tag dei
// reparti nella scheda estesa, che dicono dove si va.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Marchio } from '../data/marchi';
import { CATEGORIE } from '../data/categorie';

interface Props {
  marchio: Marchio;
  /** Scheda completa: logo, descrizione e reparti (pagina Marchi) */
  estesa?: boolean;
  /** Solo logo, in tessera (Home) */
  soloLogo?: boolean;
}
const { marchio, estesa = false, soloLogo = false } = Astro.props;
const categorie = CATEGORIE.filter((c) => marchio.categorie.includes(c.slug));

const immaginiMarchio = import.meta.glob<{ default: ImageMetadata }>('../assets/marchi/*.{png,jpg,jpeg,webp}', { eager: true });
const trova = (suffisso: string) => {
  const chiave = Object.keys(immaginiMarchio).find((k) => k.includes(`/${marchio.slug}${suffisso}`));
  return chiave ? immaginiMarchio[chiave].default : undefined;
};
const logo = trova('.');
const foto = trova('-foto.');
---
{estesa ? (
  <article class="card-marchio card-marchio--estesa">
    {foto ? (
      <div class="card-marchio__media">
        <Image src={foto} alt={`Un arredo ${marchio.nome}`} widths={[560, 900, 1400]} sizes="(max-width: 900px) 100vw, 45vw" loading="lazy" />
        {logo && (
          <span class="card-marchio__placca">
            <Image src={logo} alt={`Logo ${marchio.nome}`} widths={[160, 320]} sizes="160px" loading="lazy" />
          </span>
        )}
      </div>
    ) : (
      <div class="card-marchio__logo">
        {logo ? (
          <Image src={logo} alt={`Logo ${marchio.nome}`} widths={[280, 420]} sizes="420px" loading="lazy" />
        ) : (
          <span aria-hidden="true">{marchio.nome}</span>
        )}
      </div>
    )}
    <h2>{marchio.nome}</h2>
    <p>{marchio.descrizione}</p>
    <ul class="card-marchio__categorie" aria-label="Categorie">
      {categorie.map((c) => (
        <li><a href={`/prodotti/${c.slug}/`}>{c.nome}</a></li>
      ))}
    </ul>
  </article>
) : soloLogo ? (
  <div class="tessera-marchio">
    {logo ? (
      <Image src={logo} alt={marchio.nome} widths={[200, 400]} sizes="200px" loading="lazy" />
    ) : (
      <span>{marchio.nome}</span>
    )}
  </div>
) : (
  <div class="card-marchio">
    <h3>{marchio.nome}</h3>
    <p class="marchio">{marchio.prodotti}</p>
  </div>
)}
