---
// Hero.astro — foto a piena pagina con velo scuro; unico punto del sito
// dove compare la cornice ad angoli, la firma visiva "in esposizione".
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  titolo: string;
  sottotitolo: string;
  foto: ImageMetadata;
  altFoto: string;
  meta?: string[];
}
const {
  eyebrow = 'Sale Marasino · Lago d’Iseo',
  titolo,
  sottotitolo,
  foto,
  altFoto,
  meta = [],
} = Astro.props;
---
<section class="hero">
  <Image
    class="hero__foto"
    src={foto}
    alt={altFoto}
    widths={[800, 1400, 2000, 2600]}
    sizes="100vw"
    loading="eager"
  />
  <div class="contenitore hero__contenuto">
    <div class="hero__cornice" aria-hidden="true"></div>
    <p class="eyebrow eyebrow--chiara">{eyebrow}</p>
    <h1>{titolo}</h1>
    <p class="hero__sottotitolo">{sottotitolo}</p>
    <div class="azioni">
      <a class="bottone bottone--chiaro" href="/contatti/">Richiedi un preventivo</a>
      <a class="bottone bottone--contorno-chiaro" href="/contatti/#dove-siamo">Vieni in negozio</a>
    </div>
  </div>
</section>
{meta.length > 0 && (
  <ul class="meta-riga">
    {meta.map((m) => <li>{m}</li>)}
  </ul>
)}
