---
// CardCategoria.astro — foto (o segnaposto) sopra, etichetta e nome sotto.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Categoria } from '../data/categorie';

interface Props {
  categoria: Categoria;
}
const { categoria } = Astro.props;

const immagini = import.meta.glob<{ default: ImageMetadata }>('../assets/prodotti/*.jpg', { eager: true });
const foto = categoria.foto ? immagini[`../assets/prodotti/${categoria.foto}.jpg`]?.default : undefined;
---
<a class="card-categoria" href={`/prodotti/${categoria.slug}/`}>
  <div class="card-categoria__foto">
    {foto ? (
      <Image
        src={foto}
        alt={`${categoria.nome}: arredi in esposizione da Arredamenti Guerini a Sale Marasino`}
        widths={[400, 700, 1000]}
        sizes="(max-width: 780px) 100vw, 33vw"
        loading="lazy"
      />
    ) : (
      <p class="card-categoria__segnaposto">Foto in arrivo</p>
    )}
  </div>
  <p class="card-categoria__etichetta">{categoria.etichetta}</p>
  <h3>{categoria.nome}</h3>
</a>
