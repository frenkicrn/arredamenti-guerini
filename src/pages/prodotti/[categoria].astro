---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CardMarchio from '../../components/CardMarchio.astro';
import CtaFinale from '../../components/CtaFinale.astro';
import { CATEGORIE, type Categoria } from '../../data/categorie';
import { MARCHI } from '../../data/marchi';

export function getStaticPaths() {
  return CATEGORIE.map((categoria) => ({ params: { categoria: categoria.slug }, props: { categoria } }));
}

interface Props {
  categoria: Categoria;
}
const { categoria } = Astro.props;
const marchi = MARCHI.filter((m) => categoria.marchi.includes(m.slug));
const correlate = CATEGORIE.filter((c) => categoria.correlate?.includes(c.slug));

const immagini = import.meta.glob<{ default: ImageMetadata }>('../../assets/prodotti/*.jpg', { eager: true });
const fotoDi = (nome?: string) => (nome ? immagini[`../../assets/prodotti/${nome}.jpg`]?.default : undefined);
const fotoTesta = fotoDi(categoria.foto);
---
<Layout titoloCompleto titolo={categoria.titoloSeo} descrizione={categoria.descrizioneSeo}>
  <section class="sezione contenitore">
    <Breadcrumb voci={[{ nome: 'Home', href: '/' }, { nome: 'Prodotti', href: '/prodotti/' }, { nome: categoria.nome }]} />

    <div class="intro-categoria">
      <div>
        <p class="eyebrow eyebrow--filetto">{categoria.etichetta}</p>
        <h1>{categoria.titolo}</h1>
        <p class="intro">{categoria.intro}</p>
        {correlate.length > 0 && (
          <p class="correlate">
            Vedi anche: {correlate.map((c, i) => <>{i > 0 && ' · '}<a href={`/prodotti/${c.slug}/`}>{c.nome}</a></>)}
          </p>
        )}
        <div class="azioni">
          <a class="bottone" href="/contatti/">Richiedi un preventivo</a>
          <a class="bottone bottone--secondario" href="/contatti/#dove-siamo">Vieni in negozio</a>
        </div>
      </div>
      <div class="intro-categoria__foto">
        {fotoTesta ? (
          <Image
            src={fotoTesta}
            alt={`${categoria.nome}: arredi in esposizione da Arredamenti Guerini a Sale Marasino`}
            widths={[500, 800, 1200]}
            sizes="(max-width: 780px) 100vw, 50vw"
            loading="eager"
          />
        ) : (
          <p class="card-categoria__segnaposto">Foto in arrivo</p>
        )}
      </div>
    </div>

    {categoria.approfondimento.map((a, i) => {
      const foto = fotoDi(a.foto);
      return (
        <div class:list={['approfondimento', { 'approfondimento--inversa': i % 2 === 1, 'approfondimento--senza-foto': !foto }]}>
          {foto && (
            <div class="approfondimento__foto">
              <Image
                src={foto}
                alt={`${a.titolo}: ${categoria.nome.toLowerCase()} da Arredamenti Guerini a Sale Marasino`}
                widths={[400, 700, 1000]}
                sizes="(max-width: 780px) 100vw, 50vw"
                loading="lazy"
              />
            </div>
          )}
          <div class="approfondimento__testo">
            <h3>{a.titolo}</h3>
            <p>{a.testo}</p>
          </div>
        </div>
      );
    })}

    <div class="lista-marchi">
      <p class="eyebrow">I marchi di questo reparto</p>
      {marchi.map((m) => <CardMarchio marchio={m} />)}
    </div>
  </section>

  <CtaFinale titolo={`Un preventivo per ${categoria.nome.toLowerCase()}?`} testo="Raccontaci la stanza e le misure che hai, o fissiamo un appuntamento per venire a misurare noi." />
</Layout>
