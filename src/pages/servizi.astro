---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CtaFinale from '../components/CtaFinale.astro';
import { SERVIZI } from '../data/servizi';
---
<Layout
  titoloCompleto
  titolo="Rilievo misure, progettazione e montaggio a Sale Marasino | Arredamenti Guerini"
  descrizione="Veniamo a misurare la stanza, progettiamo sulle misure reali e montiamo con la nostra squadra: servizi compresi in zona Brescia, lago d’Iseo e Franciacorta."
>
  <section class="sezione contenitore">
    <Breadcrumb voci={[{ nome: 'Home', href: '/' }, { nome: 'Servizi' }]} />
    <h1>Dal rilievo al montaggio</h1>
    <p class="intro">Tre passaggi, nell’ordine in cui avvengono davvero. Rilievo, progetto e montaggio sono compresi in zona Brescia, lago d’Iseo e Franciacorta.</p>

    <ol class="passaggi">
      {SERVIZI.map((s, i) => (
        <li class="passaggio" id={s.slug}>
          <span class="passaggio__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h2>{s.nome}</h2>
          <p>{s.descrizione}</p>
        </li>
      ))}
    </ol>
  </section>

  <CtaFinale titolo="Iniziamo dalle misure" testo="Fissiamo un appuntamento: veniamo noi a misurare la stanza e ti prepariamo un progetto con il preventivo." />
</Layout>
