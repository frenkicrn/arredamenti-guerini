---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/karla';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BarraMobile from '../components/BarraMobile.astro';
import { NEGOZIO } from '../data/negozio';

interface Props {
  titolo: string;
  descrizione: string;
  /** true = `titolo` è già il <title> completo (non si aggiunge il nome del negozio) */
  titoloCompleto?: boolean;
}
const { titolo, descrizione, titoloCompleto = false } = Astro.props;
const titoloPagina = titoloCompleto ? titolo : `${titolo} · Arredamenti Guerini`;
// I social vogliono un URL assoluto: un percorso relativo non viene risolto.
const ogImage = new URL('/og-image.jpg', Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FurnitureStore',
  name: NEGOZIO.nome,
  description: NEGOZIO.descrizione,
  telephone: NEGOZIO.telefono,
  email: NEGOZIO.email,
  url: Astro.site?.toString(),
  address: {
    '@type': 'PostalAddress',
    streetAddress: NEGOZIO.indirizzo.via,
    postalCode: NEGOZIO.indirizzo.cap,
    addressLocality: NEGOZIO.indirizzo.comune,
    addressRegion: NEGOZIO.indirizzo.provincia,
    addressCountry: 'IT',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 45.702246,
    longitude: 10.108486,
  },
  hasMap: NEGOZIO.mapsSearchUrl,
  image: new URL('/og-image.jpg', Astro.site).href,
  areaServed: ['Sale Marasino', 'Lago d\u2019Iseo', 'Franciacorta', 'Brescia'],
  sameAs: [NEGOZIO.facebook, NEGOZIO.instagram].filter(Boolean),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '09:00',
      closes: '12:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '15:00',
      closes: '19:00',
    },
  ],
};
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titoloPagina}</title>
    <meta name="description" content={descrizione} />
    <meta property="og:title" content={titoloPagina} />
    <meta property="og:description" content={descrizione} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Arredamenti Guerini" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cucina in showroom e logo Arredamenti Guerini" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <BarraMobile />
  </body>
</html>
