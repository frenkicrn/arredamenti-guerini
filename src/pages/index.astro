---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import CaroselloReparti from '../components/CaroselloReparti.astro';
import CardMarchio from '../components/CardMarchio.astro';
import ServizioVoce from '../components/ServizioVoce.astro';
import CtaFinale from '../components/CtaFinale.astro';
import { NEGOZIO } from '../data/negozio';
import { MARCHI } from '../data/marchi';
import { SERVIZI } from '../data/servizi';
import heroFoto from '../assets/prodotti/cucina-madeleine-a.jpg';

const tel = `tel:${NEGOZIO.telefono.replaceAll(' ', '')}`;
---
<Layout
  titoloCompleto
  titolo="Arredamenti Guerini · Mobili e cucine a Sale Marasino (Lago d’Iseo)"
  descrizione="Negozio di arredamento di famiglia a Sale Marasino, sul Lago d’Iseo, dal 1969: cucine, camere, divani, materassi. Progetto, misure e montaggio compresi."
>
  <Hero
    eyebrow={`Sale Marasino · Lago d’Iseo · dal ${NEGOZIO.dal}`}
    titolo="Arrediamo la tua casa, dal progetto al montaggio"
    sottotitolo="Negozio di famiglia sul lago dal 1969. Veniamo a prendere le misure, ti mostriamo il progetto e montiamo con la nostra squadra."
    foto={heroFoto}
    altFoto="Cucina Scavolini Madeleine con ante a telaio e isola centrale"
  />

  <section class="sezione--stretta contenitore">
    <div class="punti-forza">
      <div>
        <h3>Progetto e misure senza impegno</h3>
        <p>Veniamo a misurare la stanza e ti mostriamo il disegno prima che tu ordini qualcosa.</p>
      </div>
      <div>
        <h3>Consegna e montaggio inclusi</h3>
        <p>Nella zona del lago d’Iseo, della Franciacorta e di Brescia li facciamo noi, senza costi a parte.</p>
      </div>
      <div>
        <h3>Da un mese alla consegna</h3>
        <p>Questo il tempo per gli arredi su misura. Su qualche articolo in pronta consegna si fa prima.</p>
      </div>
    </div>
  </section>

  <section class="sezione contenitore">
    <div class="testa-sezione">
      <div>
        <p class="eyebrow">I reparti</p>
        <h2>Arrediamo la casa, stanza per stanza</h2>
      </div>
      <p class="testa-sezione__appoggio">Ogni stanza la progettiamo insieme sulle misure della tua casa, scegliendo finiture e materiali dai cataloghi dei marchi che trattiamo. In negozio guardiamo i campioni e il disegno della tua stanza, con calma.</p>
    </div>
    <CaroselloReparti />
  </section>

  <section class="sezione contenitore">
    <div class="testa-sezione">
      <div>
        <p class="eyebrow">Come lavoriamo</p>
        <h2>Dal rilievo al montaggio</h2>
      </div>
      <p class="testa-sezione__appoggio">Tre passaggi, nell’ordine in cui avvengono davvero. Rilievo, progetto e montaggio sono compresi in zona Brescia, lago d’Iseo e Franciacorta.</p>
    </div>
    <div class="griglia-servizi">
      {SERVIZI.map((s) => <ServizioVoce servizio={s} breve />)}
    </div>
  </section>

  <section class="sezione contenitore">
    <div class="testa-riga">
      <h2>I marchi che trattiamo</h2>
      <a class="testa-riga__link" href="/marchi/">Tutti i marchi</a>
    </div>
    <div class="griglia-loghi">
      {MARCHI.map((m) => <CardMarchio marchio={m} soloLogo />)}
    </div>
  </section>

  <section class="sezione contenitore" id="dove-siamo">
    <div class="testa-sezione">
      <div>
        <p class="eyebrow">Dove siamo</p>
        <h2>Sulla strada del lago, a Sale Marasino</h2>
      </div>
      <p class="testa-sezione__appoggio">Siamo sulla strada che costeggia il lago, con parcheggio davanti al negozio. Passa in negozio, oppure chiamaci per fissare un appuntamento: così ti dedichiamo il tempo che serve.</p>
    </div>
    <div class="scheda-negozio">
      <div class="scheda-negozio__info">
        <p class="scheda-negozio__indirizzo">
          {NEGOZIO.indirizzo.via}<br />
          {NEGOZIO.indirizzo.cap} {NEGOZIO.indirizzo.comune} ({NEGOZIO.indirizzo.provincia})
        </p>
        <ul class="lista-orari">
          {NEGOZIO.orari.map((o) => (
            <li><span>{o.giorni}</span><span>{o.orario}</span></li>
          ))}
        </ul>
        <div class="azioni">
          <a class="bottone" href={tel}>Chiama {NEGOZIO.telefono.replace('+39 ', '')}</a>
          <a class="bottone bottone--secondario" href={NEGOZIO.mapsDirectionsUrl} rel="noopener">Indicazioni</a>
        </div>
      </div>
      <iframe
        class="scheda-negozio__mappa"
        src={NEGOZIO.mapsEmbedUrl}
        title={`Mappa: ${NEGOZIO.nome}`}
        width="720"
        height="460"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </section>

  <CtaFinale />
</Layout>
