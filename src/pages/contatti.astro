---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FormContatti from '../components/FormContatti.astro';
import Faq from '../components/Faq.astro';
import { NEGOZIO } from '../data/negozio';
import { FAQ } from '../data/faq';

const tel = `tel:${NEGOZIO.telefono.replaceAll(' ', '')}`;
const telVisibile = NEGOZIO.telefono.replace('+39 ', '');
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((v) => ({
    '@type': 'Question',
    name: v.domanda,
    acceptedAnswer: { '@type': 'Answer', text: v.risposta },
  })),
};
---
<Layout
  titoloCompleto
  titolo="Contatti e orari · Arredamenti Guerini, Sale Marasino (BS)"
  descrizione="Richiedi un preventivo o vieni in negozio a Sale Marasino: telefono, indicazioni, orari di apertura e risposte alle domande frequenti."
>
  <section class="sezione contenitore">
    <Breadcrumb voci={[{ nome: 'Home', href: '/' }, { nome: 'Contatti' }]} />
    <h1>Scrivici, o passa a trovarci</h1>
    <p class="intro">Rispondiamo noi, dal negozio. Se ci racconti la stanza fissiamo il rilievo misure e ti prepariamo il preventivo.</p>

    <div class="griglia-contatti">
      <div>
        <p class="eyebrow">Richiedi un preventivo</p>
        <h2>Raccontaci la stanza</h2>
        <p class="griglia-contatti__nota">Più cose ci scrivi (la stanza, le misure se le hai, i tempi), più il primo preventivo sarà vicino alla realtà.</p>
        <FormContatti />
      </div>

      <aside class="scheda-contatti" id="dove-siamo">
        <p class="eyebrow">Dove siamo</p>
        <dl class="dati-contatto">
          <div>
            <dt>Indirizzo</dt>
            <dd>
              <a href={NEGOZIO.mapsDirectionsUrl} rel="noopener">
                {NEGOZIO.indirizzo.via}<br />
                {NEGOZIO.indirizzo.cap} {NEGOZIO.indirizzo.comune} ({NEGOZIO.indirizzo.provincia})
              </a>
            </dd>
          </div>
          <div>
            <dt>Telefono</dt>
            <dd><a class="dati-contatto__telefono" href={tel}>{telVisibile}</a></dd>
          </div>
          <div>
            <dt>Orari</dt>
            <dd>
              Martedì – Sabato<br />
              9:00–12:00 · 15:00–19:00
              <span class="dati-contatto__nota">Lunedì e domenica chiuso</span>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="sezione--stretta sezione--ultima contenitore">
    <div class="testa-riga testa-riga--sola">
      <h2>Domande frequenti</h2>
    </div>
    <Faq voci={FAQ} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </section>
</Layout>
