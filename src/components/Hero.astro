---
// Hero.astro — Home: testo a sinistra, foto 4/5 a destra.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  titolo: string;
  sottotitolo: string;
  foto: ImageMetadata;
  altFoto: string;
}
const { eyebrow, titolo, sottotitolo, foto, altFoto } = Astro.props;
---
<section class="sezione contenitore">
  <div class="hero-home">
    <div>
      <p class="eyebrow eyebrow--filetto">{eyebrow}</p>
      <h1>{titolo}</h1>
      <p class="hero-home__sottotitolo">{sottotitolo}</p>
      <div class="azioni">
        <a class="bottone" href="/contatti/">Richiedi un preventivo</a>
        <a class="bottone bottone--secondario" href="/contatti/#dove-siamo">Vieni in negozio</a>
      </div>
    </div>
    <div class="hero-home__foto">
      <Image
        src={foto}
        alt={altFoto}
        widths={[600, 900, 1200]}
        sizes="(max-width: 780px) 100vw, 45vw"
        loading="eager"
      />
    </div>
  </div>
</section>
