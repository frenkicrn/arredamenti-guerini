---
// CtaFinale.astro — fascia scura di chiusura, in tutte le pagine.
import { NEGOZIO } from '../data/negozio';

interface Props {
  titolo?: string;
  testo?: string;
}
const {
  titolo = 'Raccontaci la stanza.\nAl resto pensiamo noi.',
  testo = 'Vieni in negozio o chiamaci: fissiamo il rilievo misure e ti mostriamo il progetto prima di ordinare qualsiasi cosa.',
} = Astro.props;
const tel = `tel:${NEGOZIO.telefono.replaceAll(' ', '')}`;
---
<section class="cta-finale">
  <div class="contenitore cta-finale__riga">
    <div>
      <h2>{titolo.split('\n').map((riga, i) => (i === 0 ? riga : <><br />{riga}</>))}</h2>
      <p>{testo}</p>
    </div>
    <div class="azioni">
      <a class="bottone" href="/contatti/">Richiedi un preventivo</a>
      <a class="bottone bottone--contorno-chiaro" href={tel}>Chiama {NEGOZIO.telefono.replace('+39 ', '')}</a>
    </div>
  </div>
</section>
