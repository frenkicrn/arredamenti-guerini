---
import { Image } from 'astro:assets';
import { NEGOZIO } from '../data/negozio';
import { CATEGORIE } from '../data/categorie';
import logo from '../assets/logo-guerini.png';

const tel = `tel:${NEGOZIO.telefono.replaceAll(' ', '')}`;
const telVisibile = NEGOZIO.telefono.replace('+39 ', '');
---
<footer class="sito-footer">
  <div class="contenitore footer-colonne">
    <div>
      <a href="/" class="logo logo--placca" aria-label={NEGOZIO.nome}>
        <Image src={logo} alt={NEGOZIO.nome} widths={[236]} sizes="236px" loading="lazy" />
      </a>
      <p>
        {NEGOZIO.indirizzo.via}<br />
        {NEGOZIO.indirizzo.cap} {NEGOZIO.indirizzo.comune} ({NEGOZIO.indirizzo.provincia})
      </p>
      <p class="footer-telefono"><a href={tel}>{telVisibile}</a></p>
    </div>
    <div>
      <h3>Prodotti</h3>
      <ul>
        {CATEGORIE.map((c) => (
          <li><a href={`/prodotti/${c.slug}/`}>{c.nome}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Il negozio</h3>
      <ul>
        <li><a href="/marchi/">Marchi</a></li>
        <li><a href="/servizi/">Servizi</a></li>
        <li><a href="/chi-siamo/">Chi siamo</a></li>
        <li><a href="/contatti/">Contatti</a></li>
      </ul>
    </div>
    <div>
      <h3>Orari</h3>
      <p>
        Martedì – Sabato<br />
        9:00–12:00 · 15:00–19:00<br />
        Lunedì e domenica chiuso
      </p>
    </div>
  </div>
  <div class="contenitore footer-legale">
    © {NEGOZIO.nome} · {NEGOZIO.indirizzo.comune} ({NEGOZIO.indirizzo.provincia}) · dal {NEGOZIO.dal}
  </div>
</footer>
